# Create a fresh key in the Groq console. Never commit your real key.
GROQ_API_KEY=replace_with_your_groq_api_key
# Use a chat model available to your Groq account.
GROQ_MODEL=openai/gpt-oss-120b
# Relative PDF paths resolve from backend/, regardless of working directory.
PDF_PATH=all_in_one.pdf
PORT=10000
